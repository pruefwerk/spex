{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/pruefwerk/spex/schemas/integration-bundle.schema.json",
  "title": "spex IntegrationBundle",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "kind", "metadata", "spec"],
  "properties": {
    "apiVersion": { "const": "spex.bundle.v0.1" },
    "kind": { "const": "IntegrationBundle" },
    "metadata": { "$ref": "#/$defs/metadata" },
    "spec": {
      "type": "object",
      "additionalProperties": false,
      "required": ["capabilities"],
      "properties": {
        "capabilities": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/capability" }
        },
        "bindingSchemas": {
          "type": "array",
          "items": { "$ref": "#/$defs/bindingSchema" }
        },
        "stepCatalogs": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "flowCatalogs": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        }
      }
    }
  },
  "$defs": {
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name"],
      "properties": {
        "name": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$" },
        "version": { "type": "string", "minLength": 1 }
      }
    },
    "capability": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "bindingKind", "probe"],
      "properties": {
        "type": { "$ref": "#/$defs/qualifiedName" },
        "inputSchema": { "$ref": "#/$defs/schemaRef" },
        "resultSchema": { "$ref": "#/$defs/schemaRef" },
        "bindingKind": { "$ref": "#/$defs/qualifiedName" },
        "probe": { "$ref": "#/$defs/probeInvocation" }
      }
    },
    "bindingSchema": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind"],
      "properties": {
        "kind": { "$ref": "#/$defs/qualifiedName" },
        "schema": { "$ref": "#/$defs/schemaRef" }
      }
    },
    "schemaRef": {
      "type": "object",
      "additionalProperties": false,
      "anyOf": [
        { "required": ["name"] },
        { "required": ["path"] },
        { "required": ["schema"] }
      ],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "path": { "type": "string", "minLength": 1 },
        "schema": { "$ref": "#/$defs/jsonSchema" }
      }
    },
    "jsonSchema": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "type": { "enum": ["object", "array", "string", "number", "integer", "boolean", "null"] },
        "required": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        },
        "properties": {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/jsonSchema" }
        },
        "items": { "$ref": "#/$defs/jsonSchema" },
        "enum": {
          "type": "array",
          "items": { "type": "string" },
          "uniqueItems": true
        },
        "additionalProperties": { "type": "boolean" }
      }
    },
    "probeInvocation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["image", "command", "input", "output"],
      "properties": {
        "image": { "type": "string", "minLength": 1 },
        "command": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "args": {
          "type": "array",
          "items": { "type": "string" }
        },
        "input": { "$ref": "#/$defs/probeIO" },
        "output": { "$ref": "#/$defs/probeIO" },
        "env": {
          "type": "object",
          "propertyNames": { "pattern": "^[A-Za-z_][A-Za-z0-9_]*$" },
          "additionalProperties": { "$ref": "#/$defs/probeEnvSource" }
        }
      }
    },
    "probeIO": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path"],
      "properties": {
        "mode": { "enum": ["", "operationFile"] },
        "path": { "type": "string", "minLength": 1 }
      }
    },
    "probeEnvSource": {
      "type": "object",
      "additionalProperties": false,
      "oneOf": [
        { "required": ["fromBinding"] },
        { "required": ["secretRef"] },
        { "required": ["value"] }
      ],
      "properties": {
        "fromBinding": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_]*(\\.[A-Za-z][A-Za-z0-9_]*)*$" },
        "secretRef": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_]*\\.[A-Za-z][A-Za-z0-9_]*(\\.[A-Za-z][A-Za-z0-9_]*)*$" },
        "value": { "type": "string" }
      }
    },
    "qualifiedName": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*\\.[A-Za-z][A-Za-z0-9_.-]*$"
    }
  }
}
