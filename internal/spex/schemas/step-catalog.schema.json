{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/pruefwerk/spex/schemas/step-catalog.schema.json",
  "title": "spex StepCatalog",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "kind", "metadata", "spec"],
  "properties": {
    "apiVersion": { "const": "spex.catalog.v0.1" },
    "kind": { "const": "StepCatalog" },
    "metadata": { "$ref": "#/$defs/metadata" },
    "spec": {
      "type": "object",
      "additionalProperties": false,
      "required": ["steps"],
      "properties": {
        "steps": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/stepDefinition" }
        }
      }
    }
  },
  "$defs": {
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name"],
      "properties": {
        "name": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$" }
      }
    },
    "stepDefinition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "expression", "output"],
      "properties": {
        "kind": { "enum": ["given", "when", "then", "and"] },
        "expression": { "type": "string", "minLength": 1 },
        "output": {
          "type": "object",
          "additionalProperties": false,
          "anyOf": [
            { "required": ["parameters"], "properties": { "parameters": { "minProperties": 1 } } },
            { "required": ["payloadTemplates"], "properties": { "payloadTemplates": { "minProperties": 1 } } },
            { "required": ["graphqlQueries"], "properties": { "graphqlQueries": { "minProperties": 1 } } },
            { "required": ["operations"], "properties": { "operations": { "minItems": 1 } } }
          ],
          "properties": {
            "parameters": { "type": "object" },
            "payloadTemplates": { "type": "object" },
            "graphqlQueries": { "type": "object" },
            "operations": {
              "type": "array",
              "items": { "type": "object" }
            }
          }
        }
      }
    }
  }
}
