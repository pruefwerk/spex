# Copy this file for live kind runs. The default integration profiles deploy
# concrete local-kind services and do not deploy fake endpoints.

SCENARIO=examples/scenarios/mqtt-ingestion-basic.yaml
BINDING=examples/bindings/local-dev.yaml
WORKSPACE=generated/mqtt-ingestion-basic-integration
RUN_ID=run-integration

KUBE_CONTEXT=kind-kind
NAMESPACE=spex-test

PROBE_IMAGE=spex-probe:dev
PROBE_IMAGE_PULL_POLICY=IfNotPresent

INTEGRATION_PROFILE=examples/integration/local-kind-profile.yaml
REPO_ROOT=

START_KIND_IN_KUTTL=false
INTEGRATION_ALLOW_PLACEHOLDER_PROFILE=false
INTEGRATION_RUN_KUTTL=true
KUBECTL=kubectl
SPEX=

SPEX_MQTT_USERNAME=dev
SPEX_MQTT_PASSWORD=dev
SPEX_GRAPHQL_TOKEN=dev-token

# Required by examples/integration/local-kind-keycloak-profile.yaml.
SPEX_KEYCLOAK_ADMIN_PASSWORD=admin-dev-password
SPEX_GRAPHQL_KEYCLOAK_CLIENT_SECRET=graphql-dev-secret
